<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScpCv.Contracts\ScpCv.Contracts.csproj" />
    <ProjectReference Include="..\..\src\ScpCv.Domain\ScpCv.Domain.csproj" />
    <ProjectReference Include="..\..\src\ScpCv.Presentation.Protocol\ScpCv.Presentation.Protocol.csproj" />
    <ProjectReference Include="..\..\src\ScpCv.ControlHost\ScpCv.ControlHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/ScpCv.LibreOfficeHost/Runtime/OfficeEngineProfile.cs" Link="OfficeRuntime/OfficeEngineProfile.cs" />
    <Compile Include="../../src/ScpCv.LibreOfficeHost/Runtime/PresentationEventBuffer.cs" Link="OfficeRuntime/PresentationEventBuffer.cs" />
    <Compile Include="../../src/ScpCv.LibreOfficeHost/Runtime/PresentationTerminalEvidence.cs" Link="OfficeRuntime/PresentationTerminalEvidence.cs" />
    <Compile Include="../../src/ScpCv.LibreOfficeHost/Uno/PresentationLoadRejectedException.cs" Link="OfficeRuntime/PresentationLoadRejectedException.cs" />
    <Compile Include="../../src/ScpCv.LibreOfficeHost/Uno/PresentationAnimationSafety.cs" Link="OfficeRuntime/PresentationAnimationSafety.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ScpCv.Presentation.TestHost/ScpCv.Presentation.TestHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../ScpCv.ParentGuard.TestHost/ScpCv.ParentGuard.TestHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyPresentationTestHost" AfterTargets="Build">
    <MSBuild Projects="../ScpCv.Presentation.TestHost/ScpCv.Presentation.TestHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="PresentationTestHostTarget" />
    </MSBuild>
    <PropertyGroup><PresentationTestHostDirectory>@(PresentationTestHostTarget->'%(RootDir)%(Directory)')</PresentationTestHostDirectory></PropertyGroup>
    <ItemGroup><PresentationTestHostFile Include="$(PresentationTestHostDirectory)*" Exclude="**/*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(PresentationTestHostFile)" DestinationFolder="$(TargetDir)PresentationTestHost" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyParentGuardTestHost" AfterTargets="Build">
    <MSBuild Projects="../ScpCv.ParentGuard.TestHost/ScpCv.ParentGuard.TestHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ParentGuardTestHostTarget" />
    </MSBuild>
    <PropertyGroup><ParentGuardTestHostDirectory>@(ParentGuardTestHostTarget->'%(RootDir)%(Directory)')</ParentGuardTestHostDirectory></PropertyGroup>
    <ItemGroup><ParentGuardTestHostFile Include="$(ParentGuardTestHostDirectory)*" Exclude="**/*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(ParentGuardTestHostFile)" DestinationFolder="$(TargetDir)ParentGuardTestHost" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\..\..\docs\components\schemas\**\*.yaml"
          Link="OpenApiSchemas\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\specs\003-dotnet-runtime-refactor\contracts\runtime-ipc.md"
          Link="Contracts\runtime-ipc.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\openapi.yaml"
          Link="OpenApi\openapi.yaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docs\paths\*.yaml"
          Link="OpenApi\paths\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
