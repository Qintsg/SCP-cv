<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScpCv.Contracts\ScpCv.Contracts.csproj" />
    <ProjectReference Include="..\ScpCv.Domain\ScpCv.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.PowerPoint" EmbedInteropTypes="true" />
  </ItemGroup>

  <!-- NuGet PackageReference 不传播 EmbedInteropTypes 到 Csc 引用；只更新已解析的现有 PIA。 -->
  <Target Name="EmbedPowerPointInteropTypes" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <ReferencePath Update="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'Microsoft.Office.Interop.PowerPoint'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
      <ReferencePathWithRefAssemblies Update="@(ReferencePathWithRefAssemblies)" Condition="'%(ReferencePathWithRefAssemblies.Filename)' == 'Microsoft.Office.Interop.PowerPoint'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>

</Project>
