<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../shared/PrivateAudioEnginePaths.cs" Link="Runtime/PrivateAudioEnginePaths.cs" />
    <Compile Include="../../shared/NativeApplicationAudioPolicy.cs" Link="Runtime/NativeApplicationAudioPolicy.cs" />
    <ProjectReference Include="..\ScpCv.Contracts\ScpCv.Contracts.csproj" />
    <ProjectReference Include="..\ScpCv.Domain\ScpCv.Domain.csproj" />
    <ProjectReference Include="..\ScpCv.Infrastructure\ScpCv.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ScreenSharing\ReceiverPage.html" />
    <EmbeddedResource Include="ScreenSharing\receiver.js" />
  </ItemGroup>

</Project>
