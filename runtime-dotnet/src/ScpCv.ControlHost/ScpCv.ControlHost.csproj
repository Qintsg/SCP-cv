<!-- 文件描述：控制服务与成熟媒体协议依赖；项目：SCP-cv；文件：ScpCv.ControlHost.csproj；作者：Qintsg；日期：2026-10-21。 -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiveStreamingServerNet" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../shared/PrivateAudioEnginePaths.cs" Link="Runtime/PrivateAudioEnginePaths.cs" />
    <Compile Include="../../shared/NativeApplicationAudioPolicy.cs" Link="Runtime/NativeApplicationAudioPolicy.cs" />
    <ProjectReference Include="..\ScpCv.Contracts\ScpCv.Contracts.csproj" />
    <ProjectReference Include="..\ScpCv.Domain\ScpCv.Domain.csproj" />
    <ProjectReference Include="..\ScpCv.Infrastructure\ScpCv.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../third-party-notices/LiveStreamingServerNet-LICENSE.txt" Link="third-party-notices/LiveStreamingServerNet-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="ScreenSharing\ReceiverPage.html" />
    <EmbeddedResource Include="ScreenSharing\receiver.js" />
  </ItemGroup>

</Project>
