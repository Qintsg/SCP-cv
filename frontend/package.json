{
  "name": "scp-cv-frontend",
  "version": "1.0.0",
  "description": "SCP-cv 共享播放控制台",
  "author": "Qintsg (饶弘玮)",
  "private": true,
  "main": "electron-dist/main.js",
  "license": "Artistic-2.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "native:prepare": "node scripts/prepare-client-preview.mjs",
    "native:check-assets": "node scripts/check-client-preview-assets.mjs",
    "native:verify-lifecycle": "node scripts/verify-client-preview-native.mjs --assets ../.validation/client-preview-020/assets",
    "native:verify-electron": "node scripts/verify-client-preview-electron.mjs --assets ../.validation/client-preview-020/assets",
    "native:verify-format": "npm run build:electron-main && node scripts/verify-preview-format.mjs",
    "dev": "vite --mode web",
    "dev:web": "vite --mode web",
    "build": "npm run build:web",
    "build:web": "vue-tsc --noEmit -p tsconfig.json && vite build --mode web",
    "build:app": "vue-tsc --noEmit -p tsconfig.json && vite build --mode app",
    "build:electron-main": "tsc -p tsconfig.electron.json",
    "build:electron": "npm run native:check-assets && npm run build:app && npm run build:electron-main && node scripts/build-electron.mjs --development-only true",
    "cap:sync": "npm run build:app && cap sync android",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@mediafish/flv": "0.2.2",
    "flvee": "0.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@vicons/fluent": "0.13.0",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "happy-dom": "20.14.5",
    "mpegts.js": "1.8.2",
    "ant-design-vue": "4.2.6",
    "pinia": "4.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.9"
  },
  "build": {
    "appId": "cn.edu.sspu.scpcv.control",
    "productName": "SCP-cv Control",
    "asar": true,
    "extraResources": [
      {
        "from": "../.validation/client-preview-020/assets",
        "to": "client-preview",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "dist-app/**/*",
      "electron-dist/**/*",
      "third-party-notices/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-electron"
    },
    "win": {
      "target": "dir"
    }
  }
}
