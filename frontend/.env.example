# SCP-cv 前端开发期环境变量
# 复制为 frontend/.env 后按实际部署修改；该文件不会被提交。

# Vite 开发服务器监听端口（host 默认 0.0.0.0）
VITE_FRONTEND_PORT=5173

# ASP.NET Core ControlHost REST/SSE 地址（含 scheme 与端口，无尾随斜杠）
VITE_BACKEND_TARGET=https://localhost:18443

# LAN屏幕共享须可信HTTPS。以下三项一起配置才启用，部分/错误配置拒绝启动。
# 服务器证书及未加密私钥使用.pem文件，存frontend目录外（推荐仓库外）。
# 不可存入public或从frontend链接出去；不要使用VITE_前缀，不分发私钥。
# SCP_CV_HTTPS_CERT_FILE=D:/SCP-cv-private/tls/d4.pem
# SCP_CV_HTTPS_KEY_FILE=D:/SCP-cv-private/tls/d4-key.pem
# SCP_CV_HTTPS_HOSTS=192.168.5.194,localhost,127.0.0.1
# 证书SAN须包含上面全部名称/IP；访问设备另行信任签发CA公开根证书。
# HTTPS代理同时校验后端TLS；本地CA后端需给Node配置NODE_EXTRA_CA_CERTS的公开根路径。
